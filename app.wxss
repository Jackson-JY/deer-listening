/* app.wxss - 全局样式 */

/* 马卡龙色系主题色 */
page {
  --primary-pink: #FFB6C1;
  --primary-blue: #A8D8EA;
  --success-green: #B5EAD7;
  --warm-orange: #FFDAC1;
  --coral-pink: #FF9AA2;
  --bg-pink: #FFF5F5;
  --text-dark: #5D5D5D;
  --text-light: #999999;
  --text-lighter: #BBBBBB;
  --border-light: rgba(168, 216, 234, 0.2);
  --shadow-color: rgba(180, 160, 200, 0.12);

  background-color: var(--bg-pink);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif;
  font-size: 14px;
  color: var(--text-dark);
  line-height: 1.5;
}

/* 通用容器 */
.container {
  padding: 16px;
}

/* 渐变背景按钮 */
.btn-gradient {
  background: linear-gradient(135deg, var(--primary-pink), var(--primary-blue));
  color: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 30rpx rgba(168, 216, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-gradient:active {
  opacity: 0.9;
  transform: scale(0.97);
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx var(--shadow-color);
  margin-bottom: 24rpx;
}

/* 标题样式 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 24rpx;
}

/* 弹性布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

/* 间距 */
.mt-20 { margin-top: 20rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-12 { margin-top: 12rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-12 { margin-bottom: 12rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }

/* 文本样式 */
.text-primary { color: var(--text-dark); }
.text-secondary { color: var(--text-light); }
.text-sm { font-size: 22rpx; }
.text-xs { font-size: 20rpx; }
.text-bold { font-weight: 700; }
.text-center { text-align: center; }

/* 徽章样式 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-pink {
  background: rgba(255, 182, 193, 0.15);
  color: var(--primary-pink);
}

.badge-blue {
  background: rgba(168, 216, 234, 0.15);
  color: var(--primary-blue);
}

.badge-green {
  background: rgba(181, 234, 215, 0.2);
  color: #4CAF91;
}

.badge-orange {
  background: rgba(255, 218, 193, 0.2);
  color: #D4925C;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes ripple {
  0% { transform: scale(1); opacity: 0.5; }
  100% { transform: scale(1.6); opacity: 0; }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out;
}

.animate-pulse {
  animation: pulse 1.4s infinite;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
