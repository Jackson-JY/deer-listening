/* subpackages/lesson/pages/detail/detail.wxss */

.page {
  background: #FFF5F5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 导航栏 */
.navbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1px solid rgba(168,216,234,0.2);
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #FFF5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #5D5D5D;
}

.nav-content {
  flex: 1;
  overflow: hidden;
}

.nav-day {
  display: block;
  font-size: 22rpx;
  color: #A8D8EA;
  font-weight: 600;
  margin-bottom: 2rpx;
}

.nav-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5D5D5D;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-unlock {
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 视频区域 */
.video-section {
  background: #1a1a2e;
}

.video-container {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 56.25%;
}

.video-player,
.video-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 锁定遮罩 */
.lock-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.75);
  backdrop-filter: blur(8px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 5;
}

.lock-icon {
  font-size: 72rpx;
}

.lock-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.lock-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}

.unlock-btn {
  margin-top: 8rpx;
  padding: 24rpx 56rpx;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 40rpx rgba(168,216,234,0.4);
}

/* 试看提示 */
.preview-tip {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(0,0,0,0.55);
  border-radius: 16rpx;
  padding: 6rpx 20rpx;
  z-index: 4;
  font-size: 22rpx;
  color: #FFB6C1;
  font-weight: 700;
}

/* 字幕区域 */
.subtitle-section {
  background: #FFFFFF;
  margin-bottom: 20rpx;
  border-bottom: 1px solid rgba(168,216,234,0.15);
}

.tab-bar {
  display: flex;
  border-bottom: 1px solid #F5F5F5;
  position: relative;
}

.tab {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.tab.active {
  font-weight: 700;
  color: #5D5D5D;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 5rpx;
  background: linear-gradient(90deg, #FFB6C1, #A8D8EA);
  border-radius: 5rpx;
}

/* 语言切换 */
.lang-switch {
  display: flex;
  background: #F5F5F5;
  border-radius: 24rpx;
  padding: 6rpx;
  margin: 20rpx 32rpx;
}

.lang-btn {
  flex: 1;
  padding: 14rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.lang-btn.active {
  background: #FFFFFF;
  color: #5D5D5D;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(180,160,200,0.15);
}

/* 字幕列表 */
.subtitle-list {
  height: 400rpx;
  padding: 0 32rpx;
}

.subtitle-item {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
  background: transparent;
  border: 1px solid transparent;
  transition: all 0.3s;
}

.subtitle-item.active {
  background: linear-gradient(135deg, rgba(255,182,193,0.15), rgba(168,216,234,0.2));
  border: 1px solid rgba(168,216,234,0.4);
}

.sub-time {
  display: block;
  font-size: 20rpx;
  color: #CCC;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.subtitle-item.active .sub-time {
  color: #A8D8EA;
}

.sub-text {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}

.subtitle-item.active .sub-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D5D5D;
}

/* 笔记内容 */
.notes-content {
  padding: 24rpx 32rpx;
  height: 400rpx;
  overflow-y: auto;
}

.note-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid #F5F5F5;
}

.note-text {
  font-size: 26rpx;
  color: #5D5D5D;
  line-height: 1.5;
}

.note-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #CCC;
  margin-top: 24rpx;
}

/* 打卡区域 */
.checkin-section {
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding-top: 32rpx;
  box-shadow: 0 -8rpx 40rpx rgba(180,160,200,0.08);
}

/* 锁定状态 */
.checkin-locked {
  padding: 48rpx 32rpx;
  text-align: center;
}

.lock-icon-large {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.locked-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 12rpx;
}

.locked-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.unlock-checkin-btn {
  display: inline-block;
  padding: 26rpx 80rpx;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 40rpx rgba(168,216,234,0.4);
}

/* 打卡内容 */
.checkin-content {
  padding: 0 32rpx 32rpx;
}

/* 已打卡 */
.already-checked {
  padding: 32rpx 0;
  text-align: center;
}

.already-badge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255,218,193,0.2);
  border: 2rpx solid rgba(255,218,193,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.badge-text {
  font-size: 64rpx;
  color: #D4925C;
}

.already-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #D4925C;
  margin-bottom: 12rpx;
}

.already-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.re-record-btn {
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 28rpx;
  color: #999;
  font-size: 26rpx;
  font-weight: 600;
}

/* 空闲状态 */
.checkin-idle {
  padding: 0;
}

.idle-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.header-line {
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #FFB6C1, #A8D8EA);
  border-radius: 8rpx;
}

.idle-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.prompt-box {
  background: linear-gradient(135deg, rgba(255,182,193,0.08), rgba(168,216,234,0.1));
  border: 1px solid rgba(168,216,234,0.25);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.prompt-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.prompt-text {
  display: block;
  font-size: 26rpx;
  color: #5D5D5D;
  line-height: 1.6;
}

.record-btn-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.record-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB6C1, #FF9AA2);
  border: 6rpx solid rgba(255,154,162,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(255,154,162,0.35);
}

.mic-icon {
  font-size: 56rpx;
}

.record-hint {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

/* 录音中 */
.checkin-recording {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
}

.recording-visual {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ripple {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 154, 162, 0.3);
}

.ripple.r1 { animation: ripple 1.5s infinite 0s; }
.ripple.r2 { animation: ripple 1.5s infinite 0.4s; }
.ripple.r3 { animation: ripple 1.5s infinite 0.8s; }

@keyframes ripple {
  0% { transform: scale(1); opacity: 0.5; }
  100% { transform: scale(1.6); opacity: 0; }
}

.record-btn.recording {
  z-index: 1;
  animation: scalePulse 0.8s infinite;
}

@keyframes scalePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

.wave-bars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 60rpx;
}

.wave-bar {
  width: 6rpx;
  background: #FF9AA2;
  border-radius: 6rpx;
  animation: wave 0.5s infinite alternate;
}

@keyframes wave {
  from { height: 8rpx; }
  to { height: 60rpx; }
}

.recording-time {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF9AA2;
}

.recording-hint {
  font-size: 24rpx;
  color: #999;
}

/* 处理中 */
.checkin-processing {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 20rpx 0;
}

.cloud-icon {
  font-size: 80rpx;
  animation: float 1.6s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(-8rpx); }
  50% { transform: translateY(8rpx); }
}

.processing-text {
  font-size: 28rpx;
  color: #999;
}

/* 识别完成 */
.checkin-recognized {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.audio-player {
  background: linear-gradient(135deg, rgba(168,216,234,0.12), rgba(168,216,234,0.05));
  border: 1px solid rgba(168,216,234,0.35);
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.play-btn-small {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #A8D8EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.wave-progress {
  flex: 1;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 8rpx;
  position: relative;
}

.wave-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: #A8D8EA;
  border-radius: 8rpx;
}

.audio-dur {
  font-size: 22rpx;
  color: #999;
}

.transcript-box {
  background: #FAFAFA;
  border-radius: 28rpx;
  padding: 24rpx;
}

.transcript-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.transcript-content {
  display: block;
  font-size: 26rpx;
  color: #5D5D5D;
  line-height: 1.6;
}

.action-btns {
  display: flex;
  gap: 20rpx;
}

.reset-btn, .submit-btn {
  flex: 1;
  padding: 26rpx;
  border-radius: 32rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.reset-btn {
  background: #F5F5F5;
  color: #999;
}

.submit-btn {
  flex: 2;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(168,216,234,0.4);
}

/* 提交中 */
.checkin-submitting {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 88rpx;
  height: 88rpx;
  border: 8rpx solid #F0F0F0;
  border-top-color: #A8D8EA;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.submitting-text {
  font-size: 28rpx;
  color: #999;
}

/* 成功 */
.checkin-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}

.success-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #B5EAD7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check {
  font-size: 64rpx;
  color: #4CAF91;
}

.success-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.success-sub {
  font-size: 26rpx;
  color: #999;
}

.streak-badge {
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  animation: bounce 0.4s 3;
}

@keyframes bounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.streak-badge text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 700;
}


