/* pages/login/login.wxss */

/* ==================== 页面容器 ==================== */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E4F3F9 0%, #F8EEF3 50%, #FFF5F5 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ==================== 浮动气泡 ==================== */
.bubble {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.bubble-1 {
  width: 160rpx;
  height: 160rpx;
  background: rgba(168, 216, 234, 0.22);
  left: -10%;
  top: 8%;
  animation: float 5.2s ease-in-out infinite;
}

.bubble-2 {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 182, 193, 0.2);
  right: 5%;
  top: 5%;
  animation: float 4.5s ease-in-out infinite 1s;
}

.bubble-3 {
  width: 72rpx;
  height: 72rpx;
  background: rgba(181, 234, 215, 0.25);
  right: 18%;
  top: 18%;
  animation: float 6s ease-in-out infinite 0.6s;
}

.bubble-4 {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 218, 193, 0.18);
  left: 5%;
  top: 38%;
  animation: float 5.5s ease-in-out infinite 1.8s;
}

.bubble-5 {
  width: 88rpx;
  height: 88rpx;
  background: rgba(168, 216, 234, 0.18);
  right: 5%;
  top: 44%;
  animation: float 4.8s ease-in-out infinite 0.3s;
}

.bubble-6 {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 182, 193, 0.22);
  left: 30%;
  top: 55%;
  animation: float 5s ease-in-out infinite 2.2s;
}

.bubble-7 {
  width: 140rpx;
  height: 140rpx;
  background: rgba(181, 234, 215, 0.15);
  left: -8%;
  top: 68%;
  animation: float 6.5s ease-in-out infinite 0.9s;
}

.bubble-8 {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 218, 193, 0.2);
  right: 8%;
  top: 72%;
  animation: float 4.2s ease-in-out infinite 1.5s;
}

@keyframes float {
  0%, 100% { transform: translateY(0); opacity: 0.6; }
  50% { transform: translateY(-28rpx); opacity: 0.9; }
}

/* ==================== 顶部区域 ==================== */
.hero-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  position: relative;
  z-index: 1;
}

/* App 图标 */
.app-icon-wrap {
  position: relative;
  margin-bottom: 48rpx;
}

.app-icon-glow {
  position: absolute;
  inset: -40rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(168, 216, 234, 0.3) 0%, transparent 70%);
  animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.08); opacity: 0.8; }
}

.app-icon {
  width: 192rpx;
  height: 192rpx;
  border-radius: 56rpx;
  background: linear-gradient(145deg, #FFB6C1 0%, #A8D8EA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 32rpx 80rpx rgba(168, 216, 234, 0.45), 0 8rpx 32rpx rgba(255, 182, 193, 0.3);
}

.headphones-icon {
  font-size: 92rpx;
}

.app-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #FFDAC1;
  border: 5rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 162, 0.3);
}

/* App 标题 */
.app-title-wrap {
  text-align: center;
  margin-bottom: 20rpx;
}

.app-subtitle {
  display: block;
  font-size: 26rpx;
  color: #A8D8EA;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

.app-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 12rpx;
  line-height: 1.25;
}

.app-desc {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin: 0;
  line-height: 1.5;
}

/* 功能标签 */
.feature-pills {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 32rpx;
  margin-bottom: 56rpx;
}

.feature-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(180, 160, 200, 0.12);
  border: 1px solid rgba(168, 216, 234, 0.2);
}

.pill-icon {
  font-size: 28rpx;
}

.pill-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #5D5D5D;
}

/* 社会证明 */
.social-proof {
  background: linear-gradient(135deg, rgba(255, 182, 193, 0.12), rgba(168, 216, 234, 0.14));
  border: 1px solid rgba(168, 216, 234, 0.25);
  border-radius: 32rpx;
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  max-width: 640rpx;
}

.avatar-stack {
  display: flex;
}

.stacked-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.stacked-avatar + .stacked-avatar {
  margin-left: -16rpx;
}

.social-text {
  flex: 1;
}

.social-main {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 2rpx;
}

.social-sub {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin: 0;
}

/* ==================== 底部操作区 ==================== */
.action-section {
  padding: 32rpx 48rpx 72rpx;
  position: relative;
  z-index: 1;
}

/* 隐私提示 */
.privacy-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.shield-icon {
  font-size: 22rpx;
}

.privacy-text {
  font-size: 22rpx;
  color: #CCC;
}

/* 微信登录按钮 - 马卡龙绿色 */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #7ED9A6, #5FCE8E);
  border: none;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 20rpx 56rpx rgba(126, 217, 166, 0.35);
}

.btn-active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 微信图标 */
.wechat-icon-img {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.wechat-icon-img-sm {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.login-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.arrow-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

/* 用户协议 */
.terms-text {
  display: block;
  font-size: 20rpx;
  color: #CCC;
  text-align: center;
  margin-top: 28rpx;
  line-height: 1.6;
}

/* 跳过按钮 */
.skip-btn {
  width: 100%;
  padding: 24rpx;
  background: transparent;
  border: none;
  color: #BDBDBD;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
}

/* ==================== 弹窗 ==================== */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 50;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.auth-sheet {
  background: #FFFFFF;
  border-radius: 56rpx 56rpx 0 0;
  overflow: visible;
  box-shadow: 0 -24rpx 100rpx rgba(100, 80, 130, 0.2);
}

.auth-content {
  padding: 0 48rpx 64rpx;
}

/* 渐变条 */
.gradient-strip {
  height: 12rpx;
  background: linear-gradient(90deg, #FFB6C1, #A8D8EA, #B5EAD7);
}

/* 手柄 */
.handle {
  width: 80rpx;
  height: 8rpx;
  background: #E8E8E8;
  border-radius: 8rpx;
  margin: 0 auto 44rpx;
}

/* 应用身份 */
.app-identity {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 44rpx;
}

.identity-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #FFB6C1, #A8D8EA);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(168, 216, 234, 0.4);
  flex-shrink: 0;
}

.headphones-icon-sm {
  font-size: 56rpx;
}

.identity-text {
  flex: 1;
}

.identity-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
}

.identity-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin: 0;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: #F5F5F5;
  margin-bottom: 36rpx;
}

/* 权限列表 */
.permission-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.permission-item {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 26rpx 28rpx;
  background: #FAFAFA;
  border-radius: 28rpx;
  margin-bottom: 16rpx;
  border: 1px solid #F0F0F0;
}

.permission-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.perm-icon {
  font-size: 40rpx;
}

.permission-info {
  flex: 1;
}

.perm-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #5D5D5D;
  margin-bottom: 4rpx;
}

.perm-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin: 0;
}

.check-icon {
  font-size: 32rpx;
  color: #B5EAD7;
}

/* 安全提示 */
.safety-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(181, 234, 215, 0.12);
  border: 1px solid rgba(181, 234, 215, 0.35);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 44rpx;
}

.safety-icon {
  font-size: 26rpx;
}

.safety-text {
  font-size: 22rpx;
  color: #5D8F7D;
  line-height: 1.5;
}

/* 操作按钮 */
.auth-actions {
  display: flex;
  gap: 24rpx;
}

.deny-btn {
  flex: 1;
  padding: 28rpx;
  background: #F5F5F5;
  border: 3rpx solid #E8E8E8;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
  box-sizing: border-box;
}

.allow-btn {
  flex: 2;
  height: 88rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #7ED9A6, #5FCE8E);
  border: none;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

/* ==================== Loading 状态 ==================== */
.loading-content {
  padding: 120rpx 48rpx 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
}

.loading-rings {
  position: relative;
  width: 144rpx;
  height: 144rpx;
}

.ring {
  position: absolute;
  border-radius: 50%;
  border-style: solid;
  border-color: #F0F0F0;
  animation: spin 1.1s linear infinite;
}

.ring-outer {
  inset: 0;
  border-width: 8rpx;
  border-top-color: #07C160;
  animation-duration: 1.1s;
}

.ring-inner {
  inset: 16rpx;
  border-width: 6rpx;
  border-top-color: #A8D8EA;
  animation: spin-reverse 1.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}

.loading-wechat-icon {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.loading-text {
  text-align: center;
}

.loading-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 8rpx;
}

.loading-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin: 0;
}

/* ==================== Preview 状态 ==================== */
.preview-content {
  padding: 0 48rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-avatar-wrap {
  margin-bottom: 32rpx;
  position: relative;
}

.preview-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 6rpx solid #fff;
  box-shadow: 0 16rpx 48rpx rgba(168, 216, 234, 0.45);
}

.verified-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #07C160;
  border: 5rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
}

.preview-info {
  text-align: center;
  margin-bottom: 40rpx;
}

.preview-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 8rpx;
}

.preview-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin: 0;
}

.info-chips {
  display: flex;
  gap: 16rpx;
  margin-bottom: 48rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.info-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F8F8F8;
  border: 1px solid #EFEFEF;
  border-radius: 40rpx;
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  color: #999;
  font-weight: 600;
}

.chip-icon {
  font-size: 22rpx;
}

.progress-bar {
  width: 100%;
  max-width: 400rpx;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, #FFB6C1, #A8D8EA, #B5EAD7);
  border-radius: 8rpx;
  animation: progress 1.6s ease-in-out forwards;
}

@keyframes progress {
  from { width: 0; }
  to { width: 100%; }
}

.progress-text {
  font-size: 22rpx;
  color: #CCC;
}

/* ==================== Success 状态 ==================== */
.success-content {
  padding: 96rpx 48rpx 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.success-icon-wrap {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 60rpx rgba(168, 216, 234, 0.5);
}

.success-icon {
  font-size: 72rpx;
  color: #fff;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin: 0;
}

.success-sub {
  font-size: 26rpx;
  color: #999;
  margin: 0;
}

/* ==================== 表单样式 ==================== */
.form-content {
  padding: 0 48rpx 64rpx;
}

.form-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.form-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 头像上传 */
.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
}

.avatar-upload-btn {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border: none;
  background: transparent;
  border-radius: 50%;
  overflow: visible;
  z-index: 1;
}

.avatar-upload-btn::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 32rpx rgba(168, 216, 234, 0.35);
}

.avatar-edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
}

.avatar-hint {
  font-size: 22rpx;
  color: #BBB;
  margin-top: 16rpx;
}

/* 手机号显示 */
.phone-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background: rgba(126, 217, 166, 0.12);
  border: 1rpx solid rgba(126, 217, 166, 0.3);
  border-radius: 20rpx;
}

.phone-icon {
  font-size: 28rpx;
  color: #5FCE8E;
}

.phone-value {
  font-size: 26rpx;
  color: #5FCE8E;
  font-weight: 600;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #FAFAFA;
  border: 2rpx solid #EEE;
  border-radius: 28rpx;
  padding: 24rpx 32rpx;
  gap: 20rpx;
}

.input-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.nick-input,
.phone-input {
  flex: 1;
  height: 44rpx;
  font-size: 30rpx;
  color: #333;
  background: transparent;
  border: none;
  outline: none;
}

.placeholder {
  color: #CCC;
  font-size: 28rpx;
}

/* 手机号按钮 - 样式与输入框一致 */
.phone-btn {
  width: 100%;
  padding: 24rpx 32rpx;
  background: #FAFAFA;
  border: 2rpx solid #EEE;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 30rpx;
  color: #333;
}

.phone-btn::after {
  border: none;
}

.phone-placeholder {
  flex: 1;
  color: #CCC;
  font-size: 28rpx;
}

.phone-value {
  flex: 1;
  color: #333;
  font-size: 30rpx;
}

/* 表单操作按钮 */
.form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.cancel-btn {
  flex: 1;
  padding: 28rpx;
  background: #F5F5F5;
  border: none;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
}

.submit-btn {
  flex: 2;
  padding: 28rpx;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border: none;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(168, 216, 234, 0.4);
}
