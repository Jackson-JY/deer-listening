<!-- pages/profile/profile.wxml -->
<view class="page">
  <!-- 头部渐变 -->
  <view class="header-section">
    <view class="header-decoration top-right"></view>
    <view class="header-decoration bottom-left"></view>

    <view class="user-info">
      <view class="avatar-wrap">
        <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
        <view class="admin-badge" wx:if="{{user.isAdmin}}">
          <text>🛡</text>
        </view>
      </view>
      <view class="user-detail">
        <text class="user-name">{{user.name}}</text>
        <view class="tags-row">
          <view class="tag {{user.isAdmin ? 'admin' : 'student'}}">
            <text>{{user.isAdmin ? '🛡 管理员' : '🎓 学员'}}</text>
          </view>
          <view class="tag">
            <text>目标 7.0 分</text>
          </view>
        </view>
      </view>
      <view class="settings-btn" bindtap="onLogout">
        <text class="settings-icon">🚪</text>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stat-card streak">
      <text class="stat-icon">🔥</text>
      <view class="stat-content">
        <text class="stat-value">{{user.streak}}</text>
        <text class="stat-unit">天</text>
      </view>
      <text class="stat-label">连续打卡</text>
    </view>
    <view class="stat-card completed">
      <text class="stat-icon">📖</text>
      <view class="stat-content">
        <text class="stat-value">{{user.completed}}</text>
        <text class="stat-unit">节</text>
      </view>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-card score">
      <text class="stat-icon">🏆</text>
      <view class="stat-content">
        <text class="stat-value">{{user.totalScore}}</text>
        <text class="stat-unit">分</text>
      </view>
      <text class="stat-label">当前水平</text>
    </view>
  </view>

  <!-- 打卡日历 -->
  <view class="calendar-section card">
    <view class="card-header">
      <text class="card-title">打卡热力日历</text>
      <text class="card-sub">本周 {{user.streak}} 天 ✓</text>
    </view>
    <view class="calendar">
      <view class="weekday-row">
        <text class="weekday">日</text>
        <text class="weekday">一</text>
        <text class="weekday">二</text>
        <text class="weekday">三</text>
        <text class="weekday">四</text>
        <text class="weekday">五</text>
        <text class="weekday">六</text>
      </view>
      <view class="calendar-grid">
        <block wx:for="{{calendarWeeks}}" wx:for-item="week" wx:key="index">
          <view class="week-row">
            <block wx:for="{{week}}" wx:for-item="day" wx:key="index">
              <view class="day-cell {{day.level > 0 ? 'active level-' + day.level : ''}}" wx:if="{{day.date}}"></view>
              <view class="day-cell empty" wx:else></view>
            </block>
          </view>
        </block>
      </view>
      <view class="calendar-legend">
        <text class="legend-text">少</text>
        <view class="legend-item level-0"></view>
        <view class="legend-item level-1"></view>
        <view class="legend-item level-2"></view>
        <view class="legend-item level-3"></view>
        <text class="legend-text">多</text>
      </view>
    </view>
  </view>

  <!-- 打卡历史 -->
  <view class="history-section card">
    <view class="card-header">
      <text class="card-title">打卡历史</text>
      <text class="card-sub">共 {{user.completed}} 次</text>
    </view>

    <block wx:for="{{checkInHistory}}" wx:key="id">
      <view class="history-item">
        <!-- 时间线 -->
        <view class="timeline-line" wx:if="{{index < checkInHistory.length - 1}}"></view>
        
        <view class="record-content" data-id="{{item.id}}" bindtap="toggleRecord">
          <view class="timeline-dot {{index === 0 ? 'first' : ''}}">
            <text>✓</text>
          </view>
          
          <view class="record-main">
            <view class="record-header">
              <view class="record-info">
                <text class="day-label">{{item.dayLabel}}</text>
                <text class="lesson-name">{{item.lesson}}</text>
              </view>
              <view class="record-meta">
                <text class="record-date">{{item.date}}</text>
                <text class="expand-icon {{expandedRecord === item.id ? 'expanded' : ''}}">▼</text>
              </view>
            </view>

            <!-- 展开内容 -->
            <view class="record-detail {{expandedRecord === item.id ? 'show' : ''}}">
              <view class="audio-player">
                <view class="play-btn-circle">
                  <text>▶</text>
                </view>
                <view class="audio-wave">
                  <view class="wave-bar" wx:for="{{12}}" wx:key="index"></view>
                </view>
                <text class="audio-duration">{{item.duration}}</text>
              </view>
              <view class="transcript">
                <text class="transcript-label">识别文本：</text>
                <text class="transcript-text">"{{item.transcript}}"</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 菜单项 -->
  <view class="menu-section card">
    <view class="menu-item">
      <view class="menu-icon" style="background: rgba(255,182,193,0.12);">
        <text>🛒</text>
      </view>
      <text class="menu-label">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <view class="menu-icon" style="background: rgba(168,216,234,0.12);">
        <text>⚙</text>
      </view>
      <text class="menu-label">账号设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item no-border">
      <view class="menu-icon" style="background: rgba(181,234,215,0.2);">
        <text>💬</text>
      </view>
      <text class="menu-label">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 管理员面板 -->
  <view class="admin-section card" wx:if="{{user.isAdmin}}">
    <view class="admin-header">
      <text class="admin-icon">🛡</text>
      <text class="admin-title">管理员面板</text>
    </view>

    <view class="admin-stats">
      <view class="admin-stat">
        <text class="stat-emoji">👥</text>
        <view class="stat-text">
          <text class="stat-num">1,284</text>
          <text class="stat-desc">本月新增学员</text>
        </view>
      </view>
      <view class="admin-stat">
        <text class="stat-emoji">📊</text>
        <view class="stat-text">
          <text class="stat-num">98%</text>
          <text class="stat-desc">课程完成率</text>
        </view>
      </view>
    </view>

    <view class="menu-item">
      <view class="menu-icon" style="background: rgba(255,182,193,0.12);">
        <text>👥</text>
      </view>
      <text class="menu-label">学员统计看板</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <view class="menu-icon" style="background: rgba(168,216,234,0.12);">
        <text>🛒</text>
      </view>
      <text class="menu-label">订单列表管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item no-border">
      <view class="menu-icon" style="background: rgba(181,234,215,0.2);">
        <text>↩</text>
      </view>
      <text class="menu-label">退款操作管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 继续学习按钮 -->
  <view class="bottom-action">
    <view class="action-btn" bindtap="goToCourses">
      <text class="action-icon">▶</text>
      <text class="action-text">继续今日学习</text>
    </view>
  </view>
</view>
