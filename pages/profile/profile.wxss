/* pages/profile/profile.wxss */

.page {
  background: #FFF5F5;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 头部渐变 */
.header-section {
  background: linear-gradient(145deg, #FFB6C1 0%, #A8D8EA 100%);
  padding: 56rpx 32rpx 72rpx;
  position: relative;
  overflow: hidden;
}

.header-decoration {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
}

.header-decoration.top-right {
  top: -60rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
}

.header-decoration.bottom-left {
  bottom: -80rpx;
  left: 20rpx;
  width: 200rpx;
  height: 200rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
}

.avatar-wrap {
  position: relative;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 6rpx solid rgba(255,255,255,0.7);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}

.admin-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFDAC1;
  border: 4rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.user-detail {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.tags-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  background: rgba(255,255,255,0.25);
  color: #FFFFFF;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.tag.admin {
  background: rgba(255,255,255,0.18);
}

.settings-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  color: #FFFFFF;
  font-size: 32rpx;
}

/* 统计卡片 */
.stats-section {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-top: -44rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 2;
}

.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(180,160,200,0.12);
}

.stat-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 12rpx;
}

.stat-content {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #5D5D5D;
  line-height: 1;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #999;
}

.stat-label {
  font-size: 20rpx;
  color: #999;
}

/* 卡片通用 */
.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 32rpx;
  margin: 0 32rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(180,160,200,0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.card-sub {
  font-size: 22rpx;
  color: #B5EAD7;
  font-weight: 600;
}

/* 日历 */
.calendar-section {
  padding-bottom: 24rpx;
}

.calendar {
  margin-top: 8rpx;
}

.weekday-row {
  display: flex;
  margin-bottom: 8rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #999;
}

.calendar-grid {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.week-row {
  display: flex;
  gap: 6rpx;
}

.day-cell {
  flex: 1;
  aspect-ratio: 1;
  border-radius: 8rpx;
  background: #F0F0F0;
}

.day-cell.level-1 { background: #C7E9D8; }
.day-cell.level-2 { background: #8BD4B3; }
.day-cell.level-3 { background: #4CAF91; }

.calendar-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 16rpx;
}

.legend-text {
  font-size: 20rpx;
  color: #999;
}

.legend-item {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.legend-item.level-0 { background: #F0F0F0; }
.legend-item.level-1 { background: #C7E9D8; }
.legend-item.level-2 { background: #8BD4B3; }
.legend-item.level-3 { background: #4CAF91; }

/* 打卡历史 */
.history-section {
  padding-bottom: 24rpx;
}

.history-item {
  position: relative;
}

.timeline-line {
  position: absolute;
  left: 36rpx;
  top: 72rpx;
  bottom: 0;
  width: 3rpx;
  background: linear-gradient(to bottom, rgba(168,216,234,0.4), transparent);
}

.record-content {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.timeline-dot {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(168,216,234,0.12);
  border: 3rpx solid rgba(168,216,234,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.timeline-dot.first {
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border: none;
}

.timeline-dot text {
  font-size: 26rpx;
}

.record-main {
  flex: 1;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.day-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 4rpx;
}

.lesson-name {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-date {
  font-size: 20rpx;
  color: #CCC;
}

.expand-icon {
  font-size: 20rpx;
  color: #CCC;
  transition: transform 0.25s;
}

.expand-icon.expanded {
  transform: rotate(180deg);
}

/* 展开详情 */
.record-detail {
  display: none;
  margin-top: 20rpx;
  background: linear-gradient(135deg, rgba(168,216,234,0.08), rgba(255,182,193,0.06));
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1px solid rgba(168,216,234,0.2);
}

.record-detail.show {
  display: block;
}

.audio-player {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.play-btn-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #A8D8EA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #FFFFFF;
}

.audio-wave {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.wave-bar {
  flex: 1;
  height: 60%;
  background: #A8D8EA;
  border-radius: 6rpx;
}

.audio-duration {
  font-size: 20rpx;
  color: #999;
}

.transcript-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.transcript-text {
  display: block;
  font-size: 24rpx;
  color: #5D5D5D;
  line-height: 1.6;
  font-style: italic;
}

/* 菜单项 */
.menu-section {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 32rpx;
  border-bottom: 1px solid #F8F8F8;
  cursor: pointer;
}

.menu-item.no-border {
  border-bottom: none;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #5D5D5D;
}

.menu-arrow {
  color: #CCC;
  font-size: 32rpx;
}

/* 管理员面板 */
.admin-section {
  border: 3rpx solid rgba(255,218,193,0.4);
}

.admin-header {
  background: linear-gradient(135deg, rgba(255,218,193,0.2), rgba(255,182,193,0.1));
  margin: -32rpx -32rpx 24rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1px solid rgba(255,218,193,0.3);
}

.admin-icon {
  font-size: 32rpx;
}

.admin-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #D4925C;
}

.admin-stats {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1px solid #F8F8F8;
  margin-bottom: 8rpx;
}

.admin-stat {
  flex: 1;
  background: #FAFAFA;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-emoji {
  font-size: 32rpx;
}

.stat-text {
  display: flex;
  flex-direction: column;
}

.stat-num {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5D5D5D;
  line-height: 1;
  margin-bottom: 4rpx;
}

.stat-desc {
  font-size: 20rpx;
  color: #999;
}

/* 底部按钮 */
.bottom-action {
  padding: 0 32rpx;
}

.action-btn {
  width: 100%;
  padding: 30rpx 0;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(168,216,234,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.action-icon {
  font-size: 32rpx;
}
