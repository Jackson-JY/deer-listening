/* pages/home/home.wxss */

.page {
  background: #FFF5F5;
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 32rpx 20rpx;
}

.header-tag {
  font-size: 22rpx;
  color: #999;
}

.header-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-top: 4rpx;
  line-height: 1.2;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.streak-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 218, 193, 0.25);
  border: 1px solid rgba(255, 218, 193, 0.5);
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
}

.streak-icon {
  font-size: 26rpx;
}

.streak-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #D4925C;
}

.share-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(168, 216, 234, 0.4);
}

.icon-share {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  transform: rotate(90deg);
}

/* Banner */
.banner-section {
  margin: 8rpx 32rpx;
  border-radius: 44rpx;
  overflow: hidden;
  position: relative;
}

.banner-swiper {
  height: 392rpx;
}

.banner-item {
  width: 100%;
  height: 392rpx;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.15) 55%, transparent 100%);
}

.banner-badge {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  background: rgba(255,255,255,0.22);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  border: 1px solid rgba(255,255,255,0.2);
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.banner-content {
  position: absolute;
  bottom: 28rpx;
  left: 28rpx;
  right: 28rpx;
}

.banner-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  white-space: pre-line;
  line-height: 1.3;
}

.banner-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 24rpx;
}

.banner-cta {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
}

.cta-icon {
  color: #FF9AA2;
  font-size: 22rpx;
}

.cta-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF9AA2;
}

/* Banner 指示器 */
.banner-dots {
  position: absolute;
  bottom: 24rpx;
  right: 28rpx;
  display: flex;
  gap: 10rpx;
}

.dot {
  height: 12rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,0.55);
  transition: all 0.28s;
}

.dot.active {
  width: 36rpx;
  opacity: 1;
}

/* Banner 箭头 */
.banner-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s;
}

.banner-arrow.hidden {
  opacity: 0;
}

.banner-arrow.left {
  left: 16rpx;
}

.banner-arrow.right {
  right: 16rpx;
}

.banner-arrow text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

/* 卖点 */
.selling-points-section {
  padding: 0 32rpx 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.section-sub {
  font-size: 22rpx;
  color: #B5EAD7;
  font-weight: 600;
}

.selling-points {
  display: flex;
  gap: 20rpx;
}

.selling-point {
  flex: 1;
  border-radius: 36rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 36rpx rgba(180,160,200,0.09);
}

.point-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.point-icon {
  font-size: 44rpx;
}

.point-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 6rpx;
}

.point-desc {
  display: block;
  font-size: 20rpx;
  color: #999;
  line-height: 1.45;
  white-space: pre-line;
}

/* 限时优惠 */
.offer-section {
  padding: 0 32rpx 40rpx;
}

.offer-card {
  background: linear-gradient(135deg, #FFF0F5 0%, #EEF8FB 100%);
  border-radius: 36rpx;
  padding: 28rpx 32rpx;
  border: 1px solid rgba(255,182,193,0.3);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.offer-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.offer-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFB6C1, #FF9AA2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.offer-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 4rpx;
}

.offer-sub {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.offer-right {
  flex-shrink: 0;
}

.offer-tag {
  font-size: 22rpx;
  color: #FF9AA2;
  font-weight: 700;
  animation: pulse 1.4s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* 预览课程 */
.preview-section {
  padding: 0 32rpx 40rpx;
}

.preview-section .section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.preview-section .section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.view-all {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #A8D8EA;
  font-weight: 600;
}

.arrow {
  font-size: 28rpx;
}

.course-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  height: 340rpx;
}

.course-preview-card {
  display: inline-block;
  width: 296rpx;
  height: 100%;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(180,160,200,0.12);
  border: 1px solid rgba(168,216,234,0.15);
  box-sizing: border-box;
  vertical-align: top;
}

.preview-thumb {
  position: relative;
  width: 100%;
  height: 176rpx;
  display: block;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.thumb-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 60%);
}

.free-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.day-badge {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.4);
}

.play-btn {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #FF9AA2;
}

.preview-info {
  padding: 16rpx;
  height: calc(100% - 176rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.preview-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #5D5D5D;
  line-height: 1.4;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.preview-duration {
  display: block;
  font-size: 20rpx;
  color: #CCC;
  margin-bottom: 12rpx;
}

.preview-cta {
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 20rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
  margin-top: auto;
}

.view-all-card {
  display: inline-block;
  width: 200rpx;
  height: 100%;
  flex-shrink: 0;
  background: linear-gradient(135deg, rgba(255,182,193,0.08), rgba(168,216,234,0.1));
  border-radius: 36rpx;
  border: 3rpx dashed rgba(168,216,234,0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 16rpx;
  box-sizing: border-box;
  vertical-align: top;
}

.view-all-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(168,216,234,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #A8D8EA;
}

.view-all-text {
  font-size: 22rpx;
  color: #A8D8EA;
  font-weight: 700;
  text-align: center;
  white-space: pre-line;
}

/* 社交证明 */
.social-proof-section {
  padding: 0 32rpx 40rpx;
}

.stats-card {
  background: linear-gradient(135deg, #FFB6C1 0%, #A8D8EA 100%);
  border-radius: 44rpx;
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 56rpx rgba(168,216,234,0.3);
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  line-height: 1;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.88);
}

/* 评价 */
.reviews-section {
  margin-top: 24rpx;
}

.review-dots {
  display: flex;
  gap: 10rpx;
}

.review-swiper {
  height: 320rpx;
}

.review-card {
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(180,160,200,0.1);
  border: 1px solid rgba(168,216,234,0.12);
}

.review-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 4rpx solid rgba(168,216,234,0.4);
}

.user-badge {
  position: absolute;
  bottom: -6rpx;
  left: 60rpx;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 16rpx;
  padding: 2rpx 10rpx;
  border: 3rpx solid #FFFFFF;
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 6rpx;
}

.user-stars {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.star {
  font-size: 22rpx;
  color: #FFB6C1;
}

.score-tag {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

.streak-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(181,234,215,0.18);
  border: 1px solid rgba(181,234,215,0.5);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #4CAF91;
  font-weight: 700;
}

.review-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.65;
  margin-bottom: 20rpx;
  font-style: italic;
}

.review-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #4CAF91;
  font-weight: 600;
  background: rgba(181,234,215,0.15);
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(181,234,215,0.3);
}

.review-hint {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #CCC;
  margin-top: 16rpx;
}

/* 信任信号 */
.trust-section {
  padding: 0 32rpx 40rpx;
}

.trust-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(180,160,200,0.08);
  display: flex;
  justify-content: space-around;
}

.trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  padding: 8rpx 0;
}

.trust-emoji {
  font-size: 44rpx;
}

.trust-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.trust-sub {
  font-size: 20rpx;
  color: #999;
}

.trust-divider {
  width: 1px;
  background: rgba(168,216,234,0.2);
  margin: 0 16rpx;
}

/* 底部 CTA */
.bottom-cta {
  padding: 0 32rpx 32rpx;
}

.cta-button {
  width: 100%;
  padding: 34rpx 0;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 20rpx 60rpx rgba(168,216,234,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.cta-icon-text {
  font-size: 36rpx;
}

/* 悬浮 CTA */
.float-cta {
  position: fixed;
  bottom: 152rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 20;
  opacity: 0;
  transform: translateY(160rpx);
  transition: all 0.3s ease;
  pointer-events: none;
}

.float-cta.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.float-btn {
  width: 100%;
  padding: 30rpx 0;
  background: linear-gradient(135deg, #FF9AA2, #A8D8EA);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 20rpx 60rpx rgba(168,216,234,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
