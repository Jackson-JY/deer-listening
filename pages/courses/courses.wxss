/* pages/courses/courses.wxss */

.page {
  background: #FFF5F5;
  min-height: 100vh;
}

/* 顶部数据区 */
.header-section {
  background: linear-gradient(135deg, #FFB6C1 0%, #A8D8EA 100%);
  padding: 36rpx 32rpx 48rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.header-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 4rpx;
}

.header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.refresh-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-icon {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

/* 数据卡片 */
.stats-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255,255,255,0.2);
  border-radius: 28rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-icon {
  font-size: 48rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.stat-unit {
  font-size: 26rpx;
  font-weight: 400;
}

/* 进度条 */
.progress-section {
  margin-top: 8rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}

.progress-bar {
  height: 16rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: rgba(255,255,255,0.9);
  border-radius: 16rpx;
  transition: width 1s ease-out;
}

/* 课程列表 */
.course-list {
  padding: 32rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.legend {
  display: flex;
  gap: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 20rpx;
  color: #999;
}

/* 课程卡片 */
.course-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(180, 160, 200, 0.1);
  position: relative;
}

.course-thumb {
  width: 200rpx;
  height: 160rpx;
  position: relative;
  flex-shrink: 0;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.lock-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.complete-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #B5EAD7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4CAF91;
  font-weight: bold;
}

.day-badge {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 16rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.day-badge.locked {
  background: rgba(180,180,180,0.9);
}

/* 课程内容 */
.course-content {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.course-info {
  flex: 1;
}

.course-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #5D5D5D;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.course-title.locked {
  color: #BBBBBB;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.play-icon {
  color: #A8D8EA;
  font-size: 20rpx;
}

.duration {
  font-size: 22rpx;
  color: #999;
}

.checked-tag {
  font-size: 20rpx;
  color: #4CAF91;
  background: #E8F8F2;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

/* 进度条 */
.course-progress {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-bar-small {
  flex: 1;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill-small {
  height: 100%;
  background: linear-gradient(90deg, #FFB6C1, #A8D8EA);
  border-radius: 8rpx;
}

.progress-text-small {
  font-size: 20rpx;
  color: #999;
}

/* 锁定提示 */
.lock-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #CCC;
  background: #F5F5F5;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  display: inline-block;
}

/* 开始学习 */
.start-hint {
  font-size: 22rpx;
  color: #A8D8EA;
  background: rgba(168,216,234,0.1);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(168,216,234,0.3);
  display: inline-block;
}

/* 箭头 */
.arrow-icon {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
  color: #CCC;
  font-size: 32rpx;
}
