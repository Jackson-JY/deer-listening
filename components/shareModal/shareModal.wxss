/* components/shareModal/shareModal.wxss */

/* 分享弹窗 */
.share-modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.share-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  backdrop-filter: blur(6px);
}

.share-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 56rpx 56rpx 0 0;
  padding: 0 40rpx 80rpx;
  box-shadow: 0 -16rpx 80rpx rgba(180, 160, 200, 0.25);
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.share-modal.show .share-modal-content {
  transform: translateY(0);
}

.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: #E8E8E8;
  border-radius: 8rpx;
  margin: 16rpx auto 32rpx;
}

.modal-header-share {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.close-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.share-card-preview {
  background: linear-gradient(145deg, #FFF0F5, #EFF8FC);
  border-radius: 40rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  border: 1px solid rgba(168,216,234,0.25);
  position: relative;
  overflow: hidden;
}

.card-decoration {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(168,216,234,0.15);
}

.card-content-preview {
  position: relative;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.user-avatar-share {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 4rpx solid rgba(168,216,234,0.5);
}

.user-text {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 26rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 4rpx;
}

.tip {
  font-size: 22rpx;
  color: #999;
}

.banner-preview {
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}

.banner-label-share {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 4rpx;
}

.banner-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  margin-bottom: 4rpx;
}

.banner-unit {
  font-size: 28rpx;
}

.banner-desc-share {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
}

.tags-preview {
  display: flex;
  gap: 12rpx;
}

.tag-p {
  font-size: 20rpx;
  color: #A8D8EA;
  background: rgba(168,216,234,0.12);
  border: 1px solid rgba(168,216,234,0.3);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.share-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 32rpx;
  background: rgba(168,216,234,0.1);
  border: 3rpx solid rgba(168,216,234,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.action-label {
  font-size: 22rpx;
  color: #5D5D5D;
}

.copy-link {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  font-size: 32rpx;
  transition: all 0.2s;
}

.copy-link.copied {
  background: rgba(181,234,215,0.2);
  border: 2rpx solid rgba(181,234,215,0.6);
}

.link-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
}

.copy-link.copied .link-text {
  color: #4CAF91;
}
