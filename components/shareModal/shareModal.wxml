<!-- components/shareModal/shareModal.wxml -->
<view class="share-modal {{show ? 'show' : ''}}" wx:if="{{show}}">
  <view class="modal-mask" bindtap="closeModal"></view>
  <view class="share-modal-content">
    <view class="modal-handle"></view>
    <view class="modal-header-share">
      <text class="modal-title">分享给好友</text>
      <view class="close-btn" bindtap="closeModal">
        <text>✕</text>
      </view>
    </view>
    <view class="share-card-preview">
      <view class="card-decoration"></view>
      <view class="card-content-preview">
        <view class="user-row">
          <image class="user-avatar-share" src="{{userData.avatar}}" />
          <view class="user-text">
            <text class="name">{{userData.name}}</text>
            <text class="tip">邀请你一起备考雅思</text>
          </view>
        </view>
        <view class="banner-preview">
          <text class="banner-label-share">我已连续打卡</text>
          <text class="banner-num">{{userData.streak}} <text class="banner-unit">天</text></text>
          <text class="banner-desc-share">雅思听力 21 天突破计划 · 加入我！</text>
        </view>
        <view class="tags-preview">
          <text class="tag-p">剑桥真题</text>
          <text class="tag-p">双语字幕</text>
          <text class="tag-p">AI打卡</text>
        </view>
      </view>
    </view>
    <view class="share-actions">
      <view class="action-item" catchtap="onShareAppMessage">
        <text class="action-icon">💬</text>
        <text class="action-label">微信好友</text>
      </view>
      <view class="action-item">
        <text class="action-icon">🌟</text>
        <text class="action-label">朋友圈</text>
      </view>
      <view class="action-item">
        <text class="action-icon">🖼</text>
        <text class="action-label">生成海报</text>
      </view>
    </view>
    <view class="copy-link {{copied ? 'copied' : ''}}" bindtap="copyLink">
      <text>{{copied ? '✓' : '🔗'}}</text>
      <text class="link-text">{{copied ? '链接已复制！' : '复制邀请链接'}}</text>
    </view>
  </view>
</view>
