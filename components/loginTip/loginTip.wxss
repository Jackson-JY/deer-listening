/* components/loginTip/loginTip.wxss */

.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像区域 */
.avatar-section {
  position: relative;
  margin-bottom: 32rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #A8D8EA;
}

.avatar.placeholder {
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn {
  position: absolute;
  bottom: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #A8D8EA;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: none;
  white-space: nowrap;
}

.avatar-btn::after {
  border: none;
}

/* 昵称区域 */
.nickname-section {
  width: 100%;
  margin-bottom: 32rpx;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.nickname-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

/* 手机号区域 */
.phone-section {
  width: 100%;
  margin-bottom: 32rpx;
}

.phone-btn {
  width: 100%;
  height: 80rpx;
  background: #fff;
  border: 2rpx solid #A8D8EA;
  border-radius: 12rpx;
  color: #A8D8EA;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.phone-btn::after {
  border: none;
}

.phone-icon {
  font-size: 32rpx;
}

.phone-success {
  font-size: 26rpx;
  color: #52c41a;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #A8D8EA 0%, #7BC6CC 100%);
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 24rpx;
}

.login-btn::after {
  border: none;
}

.login-btn.disabled {
  background: #ccc;
  color: #fff;
}

.login-tip {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}

/* 跳过按钮 */
.skip-btn {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
}

.skip-btn text {
  font-size: 26rpx;
  color: #999;
}
