/* components/shareModal.wxss */

.share-modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.share-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  backdrop-filter: blur(6px);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 56rpx 56rpx 0 0;
  padding: 0 40rpx 80rpx;
  box-shadow: 0 -16rpx 80rpx rgba(180, 160, 200, 0.25);
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.share-modal.show .modal-content {
  transform: translateY(0);
}

.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background: #E8E8E8;
  border-radius: 8rpx;
  margin: 16rpx auto 32rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5D5D5D;
}

.close-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

/* 分享卡片 */
.share-card {
  background: linear-gradient(145deg, #FFF0F5, #EFF8FC);
  border-radius: 40rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  border: 1px solid rgba(168,216,234,0.25);
  position: relative;
  overflow: hidden;
}

.card-decoration {
  position: absolute;
  border-radius: 50%;
}

.card-decoration.top-right {
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(168,216,234,0.15);
}

.card-decoration.bottom-left {
  bottom: -60rpx;
  left: 60rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,182,193,0.12);
}

.card-content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.user-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 4rpx solid rgba(168,216,234,0.5);
}

.user-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5D5D5D;
  margin-bottom: 4rpx;
}

.user-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.achievement-banner {
  background: linear-gradient(135deg, #FFB6C1, #A8D8EA);
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
}

.banner-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 4rpx;
}

.banner-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4rpx;
  line-height: 1;
}

.banner-unit {
  font-size: 28rpx;
}

.banner-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
}

.tags-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  color: #A8D8EA;
  background: rgba(168,216,234,0.12);
  border: 1px solid rgba(168,216,234,0.3);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.qr-section {
  display: flex;
  justify-content: flex-end;
}

.qr-box {
  width: 144rpx;
  height: 144rpx;
  background: #FFFFFF;
  border: 4rpx solid rgba(168,216,234,0.3);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.qr-pattern {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 4rpx;
  width: 88rpx;
}

.qr-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: #F5F5F5;
}

.qr-dot.dark {
  background: #5D5D5D;
}

.qr-label {
  font-size: 16rpx;
  color: #999;
}

/* 分享选项 */
.share-options {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.share-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.option-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 32rpx;
  border: 3rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.option-text {
  font-size: 22rpx;
  color: #5D5D5D;
}

/* 复制链接 */
.copy-link-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  transition: all 0.2s;
}

.copy-link-btn.copied {
  background: rgba(181,234,215,0.2);
  border: 2rpx solid rgba(181,234,215,0.6);
}

.copy-link-btn text:first-child {
  font-size: 32rpx;
}

.link-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
}

.copy-link-btn.copied .link-text {
  color: #4CAF91;
}
